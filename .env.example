# Copy to .env and fill in real values. Never commit .env.

# --- Message bus ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
REDIS_URL=redis://localhost:6379/0

# --- Databases ---
POSTGRES_DSN=postgresql+asyncpg://vitalstream:vitalstream@localhost:5432/vitalstream
TIMESCALE_DSN=postgresql+asyncpg://vitalstream:vitalstream@localhost:5433/vitalstream_timeseries

# --- Auth ---
JWT_SECRET_KEY=change-me-in-real-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Shared secret for service-to-service calls (ingestion's signals endpoint) —
# not a user credential, never put a real user's password here.
SERVICE_TOKEN=change-me-in-real-env

# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_INSIGHT_CACHE_TTL_SECONDS=3600

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_PORT=9100

# --- Frontend (week7) ---
# frontend/ reads its own .env.local (see frontend/.env.local.example),
# not this file — Next.js doesn't look at a monorepo root .env. This entry
# only documents what docker-compose passes the frontend container.
