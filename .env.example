# Copy to .env and fill in real values. Never commit .env.

# --- Message bus ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
REDIS_URL=redis://localhost:6379/0

# --- Databases ---
POSTGRES_DSN=postgresql+asyncpg://vitalstream:vitalstream@localhost:5432/vitalstream
TIMESCALE_DSN=postgresql+asyncpg://vitalstream:vitalstream@localhost:5433/vitalstream_timeseries

# --- Auth ---
JWT_SECRET_KEY=change-me-in-real-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_INSIGHT_CACHE_TTL_SECONDS=3600

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_PORT=9100

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
